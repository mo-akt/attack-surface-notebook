{
  "openapi": "3.0.0",
  "info": {
    "title": "Shop API",
    "version": "1.0.0"
  },

  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },

      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },

  "security": [
    {
      "BearerAuth": []
    }
  ],

  "paths": {
    "/products": {
      "get": {}
    },

    "/profile": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },

    "/admin": {
      "post": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  }
}